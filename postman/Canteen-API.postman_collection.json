        }
      ]
    },
    {
      "name": "05-Data-driven",
      "item": [
        {
          "name": "DD - Kiểm thử dữ liệu CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/menu-items",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{name}}\",\"category\":\"{{category}}\",\"price\":\"{{price}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const c = pm.iterationData.get(\"case\");",
                  "const expected = Number(pm.iterationData.get(\"expected\"));",
                  "pm.test(`[${c}] trả về ${expected}`, () => {",
                  "    pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Phản hồi dưới 500 ms\", () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(500);",
          "});",
          "if (pm.response.code !== 204) {",
          "    pm.test(\"Trả về JSON\", () => {",
          "        pm.response.to.have.header(\"Content-Type\", \"application/json\");",
          "    });",
          "}"
        ]
      }
    }
